# Universal AI Tools configuration (example values only; never commit a real .env).
#
# The server reads these from its process environment. It does NOT load .env
# files automatically. Pass them via your MCP client (e.g. `claude mcp add -e`)
# or export them in your shell.

# Required. Absolute path of the one directory the server is authorized to work in.
# Must exist and be a directory. Your home directory, its parents, and drive or
# filesystem roots are rejected.
UNIVERSAL_AI_TOOLS_WORKSPACE=/absolute/path/to/your/project

# Optional. One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO.
# Logs are always written to stderr.
UNIVERSAL_AI_TOOLS_LOG_LEVEL=INFO

# Optional. Default: false (write tools are disabled and the server is read-only).
# Set to true to register write_file, which creates NEW files in the workspace but
# never overwrites, appends to, renames, or deletes files. Only the words true and
# false are accepted (case-insensitive, surrounding whitespace ignored); any other
# value stops the server with a configuration error. Empty counts as unset.
UNIVERSAL_AI_TOOLS_ENABLE_WRITE_TOOLS=false
