# Universal AI Tools configuration (example values only; never commit a real .env).
#
# The server reads these from its process environment. It does NOT load .env
# files automatically. Pass them via your MCP client (e.g. `claude mcp add -e`)
# or export them in your shell.

# Required. Absolute path of the one directory the server is authorized to work in.
# Must exist and be a directory. Your home directory, its parents, and drive or
# filesystem roots are rejected.
UNIVERSAL_AI_TOOLS_WORKSPACE=/absolute/path/to/your/project

# Optional. One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO.
# Logs are always written to stderr.
UNIVERSAL_AI_TOOLS_LOG_LEVEL=INFO

# Must be false or unset. Environment mode has no approval and no audit log, so it is
# read-only: the server refuses to start with true. To let Claude change files, use a
# config file (below), where every change is approved and recorded.
UNIVERSAL_AI_TOOLS_ENABLE_WRITE_TOOLS=false

# ---------------------------------------------------------------------------------------
# These variables configure the server in "environment mode", kept for existing
# registrations: read-only file tools, nothing else. The server must be started with
# python -I (it refuses to start where it would import code from the current directory).
#
# The recommended setup is a config file shared by Claude Desktop and Claude Code:
#     universal-ai-tools setup --workspace C:\path\to\project
# which registers both clients with only UNIVERSAL_AI_TOOLS_CONFIG=<path of config.toml>.
# The terminal, screen, and input capabilities exist only in the config file.
#
# No API key is used or read: Claude Desktop or Claude Code is the AI. The former
# UNIVERSAL_AI_TOOLS_ENABLE_AGENT_TOOLS, UNIVERSAL_AI_TOOLS_AGENT_*, and
# UNIVERSAL_AI_TOOLS_*_API_KEY variables are refused if set.
# ---------------------------------------------------------------------------------------
